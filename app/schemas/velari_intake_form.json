      "required": true,
      "multiple": true,
      "maxSelections": 2,
      "options": [
        {
          "value": "stretched_thin",
          "label": "Stretched thin"
        },
        {
          "value": "stuck_in_routine",
          "label": "Stuck in a routine"
        },
        {
          "value": "disconnected",
          "label": "Disconnected"
        },
        {
          "value": "curious",
          "label": "Curious"
        },
        {
          "value": "energized",
          "label": "Energized"
        },
        {
          "value": "turning_point",
          "label": "At a turning point"
        },
        {
          "value": "content_ready",
          "label": "Content and ready to enjoy life"
